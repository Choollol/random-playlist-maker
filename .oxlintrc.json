{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "fix": { "imports": "safe-fix" },
        "argsIgnorePattern": "^_$"
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/common/**/*"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/features/**"],
                "message": "features/ should only depend on common/"
              }
            ]
          }
        ]
      }
    }
  ],
  "env": {
    "builtin": true
  }
}
