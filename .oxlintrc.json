{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "fix": { "imports": "safe-fix" },
        "argsIgnorePattern": "^_$"
      }
    ]
  },
  "env": {
    "builtin": true
  }
}
